---
import Layout from "../layouts/Layout.astro";
import books from "../assets/output.json";

const maxPages = Math.max(...books.map((book) => book.pages));
const shelfWidth = 45;
const mobileShelfWidth = 20;
const tagsForBook = (book: (typeof books)[number]) => {
    if (!book.tags) return [];
    return Array.isArray(book.tags) ? book.tags : [book.tags];
};
const bookTags = books.flatMap(tagsForBook);
const sections = [...new Set(bookTags)].sort();
const uncategorisedBooks = books.filter((book) => tagsForBook(book).length === 0);
if (uncategorisedBooks.length > 0) sections.push("Uncategorised");

const colorForBook = (title: string) => {
    let hash = 0;
    for (const character of title) {
        hash = (hash * 31 + character.charCodeAt(0)) % 360;
    }

    return `hsl(${hash}, 62%, 68%)`;
};

const widthForBook = (book: (typeof books)[number]) =>
    2.5 + (book.pages / maxPages) * 7.5;
const heightForBook = (book: (typeof books)[number]) =>
    10 + (book.pages / maxPages) * 6;

const rowsForBooks = (
    sectionBooks: typeof books,
    rowWidth: number,
    fillExistingRows = false,
) => {
    const rows: (typeof books)[] = [];
    const rowWidths: number[] = [];
    let currentRow: (typeof books) = [];
    let currentWidth = 0;

    for (const book of sectionBooks) {
        const width = widthForBook(book);
        if (fillExistingRows) {
            const rowIndex = rowWidths.findIndex(
                (existingWidth) => existingWidth + width <= rowWidth,
            );
            if (rowIndex !== -1) {
                rows[rowIndex].push(book);
                rowWidths[rowIndex] += width;
                continue;
            }
        }

        if (currentRow.length > 0 && currentWidth + width > rowWidth) {
            rows.push(currentRow);
            rowWidths.push(currentWidth);
            currentRow = [];
            currentWidth = 0;
        }
        currentRow.push(book);
        currentWidth += width;
    }

    if (currentRow.length > 0) {
        rows.push(currentRow);
        rowWidths.push(currentWidth);
    }
    return rows;
};
---

<Layout>
    <div class="container">
        <h1>TBR Wishlist - Total {books.length}</h1>
        <nav class="filters" aria-label="Filter books by category">
            <button class="filter-button is-active" type="button" data-filter="all">All</button>
            {sections.map((section) => (
                <button class="filter-button" type="button" data-filter={section}>{section}</button>
            ))}
        </nav>

        <div class="shelves">
            {sections.map((section) => {
                const sectionBooks = section === "Uncategorised"
                    ? uncategorisedBooks
                    : books.filter((book) => tagsForBook(book).includes(section));

                return (
                    <section class="shelf-section" data-section={section}>
                        <h2>{section}</h2>
                        <div class="shelves" aria-label={`${section} books`}>
                            <div class="shelf-list desktop-shelves">
                                {rowsForBooks(sectionBooks, shelfWidth).map((row, index) => (
                                    <div class="shelf" aria-label={`${section} shelf ${index + 1}`}>
                                        {row.map((book) => (
                                    <button
                                        class="book"
                                        type="button"
                                        aria-label={`Show cover for ${book.title}`}
                                        style={`--book-width: ${widthForBook(book)}rem; --book-height: ${heightForBook(book)}rem; --book-color: ${colorForBook(book.title)};`}
                                        data-book-tags={tagsForBook(book).join("|") || "Uncategorised"}
                                    >
                                        <span class="book-spine" aria-hidden="true">
                                            <span class="book-title">{book.title}</span>
                                            <span class="book-author">{book.author}</span>
                                        </span>
                                        <span class="book-cover">
                                            <img
                                                loading="lazy"
                                                src={`/screenshots/${book.coverScreenshot}`}
                                                alt={`Cover of ${book.title}`}
                                            />
                                            {/* <span class="cover-details">{book.title}</span> */}
                                        </span>
                                    </button>
                                        ))}
                                    </div>
                                ))}
                            </div>
                            <div class="shelf-list mobile-shelves">
                                {rowsForBooks(sectionBooks, mobileShelfWidth, true).map((row, index) => (
                                    <div class="shelf" aria-label={`${section} mobile shelf ${index + 1}`}>
                                        {row.map((book) => (
                                            <button
                                                class="book"
                                                type="button"
                                                aria-label={`Show cover for ${book.title}`}
                                                style={`--book-width: ${widthForBook(book)}rem; --book-height: ${heightForBook(book)}rem; --book-color: ${colorForBook(book.title)};`}
                                            >
                                                <span class="book-spine" aria-hidden="true">
                                                    <span class="book-title">{book.title}</span>
                                                    <span class="book-author">{book.author}</span>
                                                </span>
                                                <span class="book-cover">
                                                    <img loading="lazy" src={`/screenshots/${book.coverScreenshot}`} alt={`Cover of ${book.title}`} />
                                                    <span class="cover-details">{book.title}</span>
                                                </span>
                                            </button>
                                        ))}
                                    </div>
                                ))}
                            </div>
                        </div>
                    </section>
                );
            })}
        </div>
    </div>
</Layout>

<style>
.container {
    max-width: 90ch;
    margin: 0 auto;
    padding: 6rem 1rem 4rem;
}

.filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.5rem 0 2rem;
}

.filter-button {
    padding: 0.45rem 0.8rem;
    color: #24201c;
    background: transparent;
    border: 1px solid #8a5a3b;
    border-radius: 999px;
    cursor: pointer;
    font: inherit;
    font-size: 0.8rem;
}

.filter-button:hover,
.filter-button.is-active {
    color: #fffcf0;
    background: #8a5a3b;
}

.shelf-section {
    margin: 0 0 2.5rem;
}

.shelf-section h2 {
    margin: 0 0 0.75rem;
    font-size: 1.2rem;
}

.shelf {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    perspective: 900px;
    perspective-origin: center 70%;
    width: 100%;
    min-height: 19rem;
    padding: 1rem 0 0;
    overflow: visible;
    border-bottom: 0.7rem solid #b98c6b;
}

.mobile-shelves {
    display: none;
}

.book {
    position: relative;
    display: block;
    flex: 0 0 var(--book-width);
    width: var(--book-width);
    height: 18rem;
    padding: 0;
    color: #24201c;
    background: transparent;
    border: 0;
    cursor: pointer;
    transform-style: preserve-3d;
    transform-origin: center bottom;
    transition: transform 0.8s cubic-bezier(0.2, 0.75, 0.25, 1);
}

.book:focus-visible {
    outline: 0.2rem solid #24201c;
    outline-offset: 0.2rem;
}

.book-spine,
.book-cover {
    position: absolute;
    inset: 0;
    display: flex;
    backface-visibility: hidden;
    transition: transform 0.45s ease, opacity 0.45s ease;
    transition-delay: 0s;
}

.book-spine {
    align-items: center;
    flex-direction: column;
    justify-content: space-between;
    padding: 1rem 0.35rem 0.75rem;
    overflow: hidden;
    background: var(--book-color);
    border: 0.15rem solid rgba(36, 32, 28, 0.28);
    border-radius: 0.2rem 0.35rem 0.25rem 0.2rem;
    box-shadow:
        inset 0.25rem 0 0 rgba(255, 255, 255, 0.28),
        inset -0.2rem 0 rgba(36, 32, 28, 0.18),
        0.15rem 0.2rem 0.25rem rgba(81, 49, 31, 0.2);
    transform-origin: left center;
    transform: rotateY(0);
}

.book-spine {
    inset: auto 0 0;
    height: var(--book-height);
}

.book-spine::after {
    position: absolute;
    inset: 0.45rem 0.3rem;
    border: 1px solid rgba(36, 32, 28, 0.28);
    border-radius: 0.1rem;
    content: "";
    pointer-events: none;
}

.book-title {
    z-index: 1;
    max-height: 10.5rem;
    overflow: hidden;
    font-size: clamp(0.55rem, 1.1vw, 0.78rem);
    font-weight: 700;
    line-height: 1.1;
    text-align: center;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
}

.book-author {
    z-index: 1;
    max-width: 100%;
    overflow: hidden;
    font-size: 0.55rem;
    line-height: 1;
    text-align: center;
    text-overflow: ellipsis;
    writing-mode: vertical-rl;
    white-space: nowrap;
}

.book-cover {
    display: block;
    width: 12rem;
    aspect-ratio: 2 / 3;
    height: auto;
    overflow: hidden;
    background: #24201c;
    border-radius: 0.2rem;
    opacity: 0;
    transform: rotateY(-90deg);
    transform-origin: left center;
}

.book:not(.is-open) .book-spine {
    opacity: 1;
    transform: rotateY(0);
}

.book:not(.is-open) .book-cover {
    opacity: 0;
    transform: rotateY(-90deg);
}

.book-cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
}

.cover-details {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    padding: 0.45rem;
    color: #fffcf0;
    background: rgba(36, 32, 28, 0.78);
    font-size: 0.65rem;
    text-align: center;
}

.book.is-open {
    z-index: 2;
    transform: translate3d(0, -2rem, 8rem) rotateX(-3deg);
}

.book.is-open .book-spine {
    transform: rotateY(90deg);
    transition-delay: 0.35s;
}

.book.is-open .book-cover {
    opacity: 1;
    transform: rotateY(0);
    transition-delay: 0.35s;
}

.shelf-section.is-hidden {
    display: none;
}

@media (max-width: 600px) {
    .container {
        padding-top: 4rem;
    }

    .shelf {
        padding-inline: 0.5rem;
        min-height: 17rem;
    }

    .desktop-shelves {
        display: none;
    }

    .mobile-shelves {
        display: block;
    }

    .book {
        height: 16rem;
    }

    .book-spine {
        height: min(var(--book-height), 15rem);
    }

    .book-cover {
        width: 10rem;
        height: auto;
    }

    .book.is-open {
        position: fixed;
        top: 50%;
        left: 50%;
        width: 10rem;
        height: 15rem;
        z-index: 10;
        transform: translate3d(-50%, calc(-50% - 1rem), 4rem) rotateX(-2deg);
    }

    .book:not(.is-open) {
        transform: none;
    }

}
</style>

<script>
    const filterButtons = document.querySelectorAll<HTMLButtonElement>(".filter-button");
    const shelfSections = document.querySelectorAll<HTMLElement>(".shelf-section");
    const books = document.querySelectorAll<HTMLButtonElement>(".book");

    filterButtons.forEach((button) => {
        button.addEventListener("click", () => {
            const filter = button.dataset.filter;
            filterButtons.forEach((item) => item.classList.toggle("is-active", item === button));
            shelfSections.forEach((section) => {
                section.classList.toggle("is-hidden", filter !== "all" && section.dataset.section !== filter);
            });
        });
    });

    books.forEach((book) => {
        book.addEventListener("click", () => {
            const wasOpen = book.classList.contains("is-open");
            books.forEach((item) => item.classList.remove("is-open"));
            if (!wasOpen) book.classList.add("is-open");
        });

        book.addEventListener("blur", () => {
            book.classList.remove("is-open");
        });
    });
</script>
